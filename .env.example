# Copy to `.env` (git-ignored) next to docker-compose.yml.

# Docker Hub namespace the images are tagged/pushed under: <DOCKER_USER>/telephony-*:latest
DOCKER_USER=your-dockerhub-username

# Build-time only (dev machine): Hugging Face token with access to the gated
# pyannote/speaker-diarization-3.1 and pyannote/segmentation-3.0 models.
# Passed as a BuildKit secret, never stored in an image. Not needed to pull/run.
HF_TOKEN=

# Optional: Postgres credentials (defaults: admin / secret / awaazonboard)
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=secret
# POSTGRES_DB=awaazonboard
